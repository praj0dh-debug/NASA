# Junior Astronaut Mission Trainer - Environment Configuration
# Copy this file to .env for local development

# Port for the development and production server
PORT=3000

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Base URL for API requests
VITE_API_BASE_URL=/api

# COPPA strict mode: blocks any PII (names, phone, address) from ever being stored
COPPA_STRICT_MODE=true

# Optional: Supabase configuration (if connecting external Postgres/Supabase instance)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
